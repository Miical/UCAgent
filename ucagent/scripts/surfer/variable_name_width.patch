+    fn variable_name_width(&self, ctx: &egui::Context) -> f32 {
+        let waves = self.user.waves.as_ref().unwrap();
+        let style = ctx.style();
+        let text_size = self.user.config.layout.waveforms_text_size;
+        let has_groups = waves.items_tree.iter().any(|node| node.level > 0);
+        let group_icon = if has_groups {
+            text_size + style.spacing.item_spacing.x
+        } else {
+            0.0
+        };
+        let frame_padding = Frame::side_top_panel(&style).inner_margin.sum().x;
+        let padding = frame_padding
+            + 2.0 * style.spacing.button_padding.x
+            + style.spacing.scroll.allocated_width()
+            + 4.0;
+        ctx.fonts_mut(|fonts| {
+            waves
+                .items_tree
+                .iter_visible_extra()
+                .filter_map(|entry| {
+                    let item = waves.displayed_items.get(&entry.node.item_ref)?;
+                    let DisplayedItem::Variable(variable) = item else {
+                        return None;
+                    };
+                    let mut label = LayoutJob::default();
+                    item.add_to_layout_job(
+                        Color32::BLACK,
+                        &style,
+                        &mut label,
+                        None,
+                        &self.user.config,
+                    );
+                    let expand_icon = if matches!(variable.info, VariableInfo::Compound { .. }) {
+                        style.spacing.indent
+                    } else {
+                        0.0
+                    };
+                    Some(
+                        fonts.layout_job(label).size().x
+                            + 10.0 * f32::from(entry.node.level)
+                            + group_icon
+                            + expand_icon
+                            + padding,
+                    )
+                })
+                .fold(0.0, f32::max)
+        })
