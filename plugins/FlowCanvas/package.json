{
  "name": "ucagent-flowcanvas-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:markdown && npm run build:rtl",
    "build:markdown": "esbuild frontend/markdown.js --bundle --format=esm --minify --legal-comments=eof --outfile=src/flowcanvas/web/markdown-renderer.js",
    "build:rtl": "python3 scripts/build_rtl_viewer.py"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.3",
    "markdown-it-task-lists": "2.1.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
